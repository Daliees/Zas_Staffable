[
  {
    "id": "flow-whatsapp-hr",
    "type": "tab",
    "label": "WhatsApp HR Agent",
    "disabled": false,
    "info": "Webhook -> agent -> Salesforce task"
  },
  {
    "id": "http-in-whatsapp",
    "type": "http in",
    "z": "flow-whatsapp-hr",
    "name": "WhatsApp webhook",
    "url": "/webhook/whatsapp",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 120,
    "wires": [["fn-parse-whatsapp"]]
  },
  {
    "id": "fn-parse-whatsapp",
    "type": "function",
    "z": "flow-whatsapp-hr",
    "name": "Parse WhatsApp payload",
    "func": "msg.payload = {\n  text: msg.payload.Body || msg.payload.text || \"\",\n  from: msg.payload.From || msg.payload.from || \"\"\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 400,
    "y": 120,
    "wires": [["http-agent-request"]]
  },
  {
    "id": "http-agent-request",
    "type": "http request",
    "z": "flow-whatsapp-hr",
    "name": "Agent service",
    "method": "POST",
    "ret": "obj",
    "url": "http://localhost:4001/agent",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "x": 640,
    "y": 120,
    "wires": [["switch-action"]]
  },
  {
    "id": "switch-action",
    "type": "switch",
    "z": "flow-whatsapp-hr",
    "name": "Action?",
    "property": "payload.action",
    "propertyType": "msg",
    "rules": [
      { "t": "eq", "v": "create_salesforce_task", "vt": "str" },
      { "t": "eq", "v": "answer_faq", "vt": "str" },
      { "t": "else" }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 3,
    "x": 860,
    "y": 120,
    "wires": [["fn-build-task"], ["fn-respond-faq"], ["fn-respond-default"]]
  },
  {
    "id": "fn-build-task",
    "type": "function",
    "z": "flow-whatsapp-hr",
    "name": "Build Salesforce Task",
    "func": "const task = msg.payload.task || {};\nmsg.headers = {\n  Authorization: `Bearer ${env.get('SF_ACCESS_TOKEN')}`,\n  'Content-Type': 'application/json'\n};\nmsg.url = `https://${env.get('SF_INSTANCE_URL')}/services/data/v60.0/sobjects/Task/`;\nmsg.payload = {\n  Subject: task.subject || 'HR follow-up request',\n  Description: task.description || msg.payload.reply || '',\n  Priority: task.priority || 'Normal',\n  ActivityDate: task.dueDate || undefined,\n  WhoId: task.whoId || undefined\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 1090,
    "y": 80,
    "wires": [["http-salesforce"]]
  },
  {
    "id": "http-salesforce",
    "type": "http request",
    "z": "flow-whatsapp-hr",
    "name": "Salesforce Create Task",
    "method": "POST",
    "ret": "obj",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "senderr": false,
    "x": 1330,
    "y": 80,
    "wires": [["http-response-task"]]
  },
  {
    "id": "http-response-task",
    "type": "http response",
    "z": "flow-whatsapp-hr",
    "name": "Task response",
    "statusCode": "",
    "headers": {},
    "x": 1560,
    "y": 80,
    "wires": []
  },
  {
    "id": "fn-respond-faq",
    "type": "function",
    "z": "flow-whatsapp-hr",
    "name": "Respond FAQ",
    "func": "msg.payload = { reply: msg.payload.reply || 'Thanks! HR will follow up shortly.' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 1080,
    "y": 140,
    "wires": [["http-response"]]
  },
  {
    "id": "fn-respond-default",
    "type": "function",
    "z": "flow-whatsapp-hr",
    "name": "Respond default",
    "func": "msg.payload = { reply: msg.payload.reply || 'Thanks! An HR teammate will follow up if needed.' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 1080,
    "y": 200,
    "wires": [["http-response"]]
  },
  {
    "id": "http-response",
    "type": "http response",
    "z": "flow-whatsapp-hr",
    "name": "WhatsApp Response",
    "statusCode": "",
    "headers": {},
    "x": 1330,
    "y": 170,
    "wires": []
  }
]
